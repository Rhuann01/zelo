# ==========================================
# Zelo — Variáveis de Ambiente (Exemplo)
# ==========================================

# App & URL Pública
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Local ou Produção)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Cloudflare Turnstile (Anti-bot no Agendamento)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=sua-vapid-public-key
VAPID_PRIVATE_KEY=sua-vapid-private-key

# Pagamentos Asaas (sandbox | production)
ASAAS_ENV=sandbox
ASAAS_API_KEY=sua-asaas-api-key
ASAAS_WEBHOOK_TOKEN=seu-token-webhook-asaas

# Super Admin (Torre de Controle)
SUPER_ADMIN_EMAILS=fundador@zelo.app
SUPER_ADMIN_UIDS=
SUPER_ADMIN_PIN=
SUPER_ADMIN_REQUIRE_MFA=false
SUPER_ADMIN_ALLOW_LOCAL_AAL1=true
CF_ACCESS_REQUIRED=false

# Cron de Notificações (Lembretes 30min / Trial)
CRON_SECRET=seu-cron-secret

# Banco de Fotos Gratuitas (Opcional — /painel/gestao & /onboarding)
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
PIXABAY_API_KEY=
